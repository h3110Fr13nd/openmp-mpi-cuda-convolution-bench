#!/usr/bin/env bash
set -euo pipefail

if [[ "${USE_CLANG:-0}" == "1" ]]; then
	if [[ ! -e /usr/lib/llvm-21/lib/libomp.so && ! -e /usr/lib/x86_64-linux-gnu/libomp.so ]]; then
		echo "libomp not found. Install libomp-21-dev to enable OpenMP target offload." >&2
		exit 1
	fi
	cmake -S . -B build -DCMAKE_CXX_COMPILER=clang++-21 -DOPENMP_TARGET_NVPTX=ON
else
	cmake -S . -B build
fi
cmake --build build -j
